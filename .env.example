# Optional provider overrides for local development.
# Never commit real credentials.

# Development/evaluation routing endpoint. Must be HTTPS in production.
VITE_OSRM_URL=https://router.project-osrm.org

# Development/evaluation weather endpoint. Must be HTTPS.
VITE_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# CAB-owned HTTPS endpoint that keeps TomTom/HERE/etc. credentials server-side.
# Example only; no traffic data is requested until this is configured.
VITE_TRAFFIC_PROXY_URL=https://traffic.example.invalid/v1/route
